# Copy to .env; docker compose reads it. Export it yourself when running uvicorn directly.
FUNDEB_ENV=production
FUNDEB_DATA_SOURCE=database
POSTGRES_DB=fundeb
POSTGRES_USER=fundeb
POSTGRES_PASSWORD=
# Generate a random key of at least 32 characters; keep the old production key during migration.
FUNDEB_SECRET_KEY=
FUNDEB_ALLOWED_ORIGINS=
FUNDEB_COOKIE_SECURE=true
# PostgreSQL is mandatory in every environment; SQLite/files are not runtime backends.
# Direct (non-Compose) database connection, e.g. postgresql+psycopg://user:password@localhost:5432/fundeb
# FUNDEB_DATABASE_URL=
# Chat. A chave fica só neste arquivo, que não entra no Git.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
FUNDEB_CHAT_ENABLED=true
FUNDEB_CHAT_FREE_ONLY=true
